# Keep actual credentials in local environment / secret manager. NEVER commit .env.
PORTAL_ADMIN_TOKEN=replace-with-long-random-secret
PORTAL_DATA_DIR=./portal-data
PORTAL_MAX_UPLOAD_BYTES=1073741824
PORTAL_MAX_DOWNLOAD_SIZE=1G
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=expert-video-portal-private
PORTAL_AUTO_R2_UPLOAD=true
